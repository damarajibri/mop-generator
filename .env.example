# Docker Environment Configuration for MOP Generator
# Copy this to .env for local Docker development

# Database Configuration
DATABASE_URL=postgresql://mop_user:mop_password_2026@postgres:5432/mop_generator

# Flask Configuration
FLASK_ENV=production
FLASK_SECRET_KEY=mop-generator-docker-secret-2026
PORT=8080

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# Optional: Redis Configuration
REDIS_URL=redis://redis:6379/0

# Development Override (uncomment for development)
# FLASK_ENV=development
# FLASK_DEBUG=1